NODE_ENV=development
PORT=3001

# Supabase
# 应用运行时连接串（TypeORM 使用）
# 从 Dashboard → Connect 复制当前项目的 pooler 连接串。
# Session pooler 通常是 5432；Transaction pooler 通常是 6543 且可能带 pgbouncer 参数。
# 本地长连接服务优先用 Session pooler；serverless 或短连接环境可按 Supabase 建议使用 Transaction pooler。
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# TypeORM SQL 日志（调试时开启）
TYPEORM_LOGGING=false
# 直连（migration/backfill 排障时使用，要求运行环境能访问 Supabase direct host）
# 必须从 Dashboard → Settings → Database → Direct connection 复制。
# 这里的 host 应该是 db.[PROJECT-REF].supabase.co，不能仍然是 *.pooler.supabase.com。
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# 从 Dashboard → Settings → API → Project URL 复制
SUPABASE_URL=https://[PROJECT-REF].supabase.co
# 从 Dashboard → Settings → API → service_role 复制
SUPABASE_SERVICE_ROLE_KEY=

# 千问 / DashScope（LLM + Embeddings）
# 注册：https://dashscope.aliyuncs.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
MODEL_NAME=qwen-plus
EMBEDDINGS_MODEL_NAME=text-embedding-v3
# Reranker：默认使用 LLM JSON；设为 dashscope 时优先调用 qwen3-rerank，失败后回退 LLM JSON
RERANKER_PROVIDER=llm-json
RERANKER_MODEL=qwen3-rerank
RERANKER_TIMEOUT_MS=8000
DASHSCOPE_RERANKER_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
ENABLE_SEMANTIC_CHUNKING=false
SEMANTIC_CHUNKING_SIMILARITY_THRESHOLD=0.76
SEMANTIC_CHUNKING_MAX_CHARS=900
ENABLE_CONTEXTUAL_RETRIEVAL=false
CONTEXTUAL_RETRIEVAL_MODEL_NAME=qwen-plus
RAG_SEMANTIC_CACHE_ENABLED=false
RAG_SEMANTIC_CACHE_TTL_SECONDS=1800
RAG_SEMANTIC_CACHE_MIN_SIMILARITY=0.92
# RAG 图谱派生索引版本；默认不启用图谱检索，避免未回填索引影响线上检索
ENABLE_GRAPH_RETRIEVAL=false
GRAPH_INDEX_VERSION=graph-schema-v1
RAG_GRAPH_EXTRACTOR_VERSION=graph-extractor-v1
# Parent-Child 派生索引版本；只在 strategy.parentContext=true 时读取
PARENT_CHILD_INDEX_VERSION=parent-child-v1
PARENT_CHILD_PARENT_MAX_CHARS=2000
PARENT_CHILD_MAX_CHILD_CHUNKS=5

# ASR（DashScope Paraformer）
ASR_MODEL=paraformer-realtime-v2

# TTS / 语音克隆（DashScope CosyVoice）
TTS_MODEL=cosyvoice-v3.5-plus
TTS_DEFAULT_VOICE=longxiaochun

# ES / Kibana（BM25 关键词检索派生索引）
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=digital-human
ELASTICSEARCH_INDEX_VERSION=v2
HYBRID_KEYWORD_BACKEND=pg

# 数字人（Simli）
# 注册：https://simli.ai
# 获取可用 faceId：GET https://api.simli.ai/getPossibleFaceIDs (带 x-simli-key 请求头)
DIGITAL_HUMAN_PROVIDER=mock
SIMLI_API_KEY=
SIMLI_FACE_ID=
SIMLI_BASE_URL=https://api.simli.ai
