# 应用运行
NODE_ENV=development
PORT=3001

# 数据库 / Supabase
# 应用运行时连接串，TypeORM 使用。优先使用 Supabase Session pooler。
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# 迁移、回填或排障使用的直连地址。
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LLM / Embeddings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-max
EMBEDDINGS_MODEL_NAME=text-embedding-v3

# ASR / TTS 模型
ASR_MODEL=paraformer-realtime-v2
TTS_MODEL=cosyvoice-v3.5-plus
TTS_DEFAULT_VOICE=longxiaochun

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=digital-human-agent

# 数字人
DIGITAL_HUMAN_PROVIDER=mock
SIMLI_API_KEY=
SIMLI_FACE_ID=
SIMLI_BASE_URL=https://api.simli.ai

# TTS Provider
TTS_PROVIDER=dashscope
TTS_TRANSPORT=ws
TTS_BASE_URL=https://dashscope.aliyuncs.com
TTS_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference/

# 检索 / Elasticsearch
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
HYBRID_KEYWORD_BACKEND=pg
